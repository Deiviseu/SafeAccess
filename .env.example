# Copie este arquivo para ".env.local" (ele NÃO vai para o GitHub) e preencha.
# No Vercel, cadastre as mesmas duas variáveis em Settings → Environment Variables.
#
# Supabase → Project Settings → API Keys
# Use a chave PUBLICÁVEL (sb_publishable_...). NUNCA a secret / service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI
